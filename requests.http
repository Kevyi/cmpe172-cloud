  "end_time": "2026-03-10T17:00:00"
}

### POST cancel appointment
POST http://localhost:8080/api/appointments/random1231321312312/cancel
Content-Type: application/json

### POST start cloud app
POST http://localhost:8080/api/cloud/start
Content-Type: application/json

### GET server health
GET http://localhost:8080/server
Accept: application/json
